# ==============================================================================
# DeadlineOS Backend Environment Configuration Template
# NOTE: Replace placeholder values with your real configuration in .env
# NEVER commit real credentials or keys to version control.
# ==============================================================================

# Application Mode (development | testing | production)
FLASK_ENV=production
FLASK_APP=app.py
FLASK_SECRET_KEY=your-secure-random-secret-key-here
PORT=5000

# Database Connection (Neon / PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/deadlineos?sslmode=require

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://deadlineos.vercel.app,http://localhost:5173

# Authentication / JWT
JWT_SECRET=your-jwt-secret-or-supabase-jwt-secret-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Primary AI Provider: OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Fallback AI Provider: Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_DELAY=1.5
GEMINI_CACHE_TTL=300
GEMINI_CACHE_MAXSIZE=100

# Rate Limiting
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200 per minute
RATELIMIT_AI=30 per minute

# Logging
LOG_LEVEL=INFO
